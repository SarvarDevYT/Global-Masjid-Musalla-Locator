# Server Configuration
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1

# CORS Allowed Origins (Comma-separated)
CORS_ORIGIN=*

# PostgreSQL / PostGIS (Optional - in-memory store activates if unreachable)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/masjid_locator
DB_HOST=localhost
DB_PORT=5432
DB_NAME=masjid_locator
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Overpass API (OpenStreetMap)
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# Neon Object Storage (S3-Compatible)
AWS_ENDPOINT_URL_S3=https://your-neon-storage-endpoint
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=your-neon-access-key
AWS_SECRET_ACCESS_KEY=your-neon-secret-key
S3_BUCKET=uploads

# Admin Panel Authentication
# Generate hash: node -e "console.log(require('bcryptjs').hashSync('your_password', 10))"
ADMIN_PASSWORD_HASH=$2b$10$0Z8JfgSa1Nc1fO7MPmndxel/Iv0HaScYKtk94OZn3lz9yrwTgf3ki
# Kamida 32 belgili tasodifiy satr: crypto.randomBytes(32).toString('hex')
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars_long

