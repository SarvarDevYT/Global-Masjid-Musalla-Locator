# Server Configuration
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1

# CORS Allowed Origins (Comma-separated)
CORS_ORIGIN=*

# PostgreSQL / PostGIS (Optional - in-memory store activates if unreachable)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/masjid_locator
DB_HOST=localhost
DB_PORT=5432
DB_NAME=masjid_locator
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Overpass API (OpenStreetMap)
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# Neon Object Storage (S3-Compatible)
S3_ENDPOINT=https://your-neon-storage-endpoint
S3_REGION=eu-central-1
S3_ACCESS_KEY_ID=your-neon-access-key
S3_SECRET_ACCESS_KEY=your-neon-secret-key
S3_BUCKET_NAME=uploads
S3_PUBLIC_URL=https://your-neon-storage-public-url/uploads
